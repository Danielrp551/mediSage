# ───────────────────────────────────────────────
# Bold Template Stack — Backend environment
# Copy to `.env` and fill in actual values.
# ───────────────────────────────────────────────

# ── General ──
PROJECT_NAME="Bold Template Stack"
ENV_NAME=dev                   # dev | qa | prod
DEBUG=True                     # exposes /docs and /redoc
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1

# ── Server ──
HOST=0.0.0.0
PORT=8080

# ── Database (PostgreSQL) ──
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bold_template
DB_ECHO=False
USE_UNIX_SOCKET=False
CLOUD_SQL_INSTANCE=your-project:us-central1:your-instance

# ── Security ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-secure-random-secret-of-at-least-48-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS (frontend origins) ──
# Comma-separated list. The app sends credentials (httpOnly cookies) via the
# Next.js server, so '*' is rejected at boot — list explicit origins.
CORS_ORIGINS=http://localhost:3000

# ── Rate limit (slowapi: "<N>/<minute|hour|day>") ──
# Note: in-memory limiter, per Cloud Run instance. For real enforcement across
# instances back it with Redis (see docs/HARDENING.md).
LOGIN_RATE_LIMIT="5/minute"
AUTH_BURST_RATE_LIMIT="30/minute"
# Set to True when running behind Cloud Run / Vercel / any LB so slowapi keys
# off the original client IP via X-Forwarded-For. False when exposed directly.
RATE_LIMIT_TRUST_FORWARDED=False

# ── JWT claims ──
# Set per-environment so a leaked token can't be replayed across envs.
JWT_ISSUER="bold-template-stack"
JWT_AUDIENCE="bold-template-stack"

# ── Seed user (created on first run) ──
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
