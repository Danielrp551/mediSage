@startuml class-backend-crm
' Propósito: jerarquía OO del módulo crm (modelo FINAL, 12 entidades) — Person + estados lead/customer separados,
'            matriz de transiciones configurable (ADR-008), identifiers multicanal, assignment round-robin y activity polimórfica.
' Última actualización: 2026-06-20
' Código de referencia: backend/app/modules/crm/ y backend/app/shared/

!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 50
skinparam ranksep 65
skinparam defaultFontSize 13
hide empty members

title Class — Backend · CRM module

' ─────────────────────────────────────────────────────────────
' Shared layer — mixins y base genérica
' ─────────────────────────────────────────────────────────────
package "app.shared" <<Frame>> {
  together {
    class PrimaryKeyMixin <<mixin>> {
      +id: str <<UUID>>
    }
    class ActiveMixin <<mixin>> {
      +active: bool
    }
    class SoftDeleteMixin <<mixin>> {
      +deleted_at: datetime?
    }
    class TimestampMixin <<mixin>> {
      +created_on: datetime
      +created_by: str
      +updated_on: datetime
      +updated_by: str
    }
  }

  abstract class "BaseRepository<ModelT>" as BaseRepository {
    +ALLOWED_FIELDS: set<str>
    +model: type<ModelT>
    --
    +get_by_id(db, id, ...): ModelT?
    +get_paginated(db, query_request, load): tuple<list, int>
    +create(db, obj): ModelT
    +update(db, obj, changes): ModelT
    +soft_delete(db, obj): None
  }
}

' ─────────────────────────────────────────────────────────────
' Enums (en código, NO en BD — varchar plano en las columnas)
' ─────────────────────────────────────────────────────────────
package "app.modules.crm.enums" <<Frame>> {
  enum ChannelType <<enum>> {
    whatsapp
    telegram
    web
    phone
    email
    instagram
    facebook
    other
  }

  enum ActivityType <<enum>> {
    ' Emitidos por el asesor (crm MVP)
    NOTE
    CALL_ATTEMPT
    FOLLOW_UP_SCHEDULED
    FOLLOW_UP_COMPLETED
    ' Emitidos por crm (sistema)
    STATUS_CHANGE
    REASSIGNED
    CAMPAIGN_ATTRIBUTION
    ' En el enum YA, emitidos luego por conversations/scheduling
    MESSAGE_SENT
    CONVERSATION_TAKEN
    CONVERSATION_RELEASED
    APPOINTMENT_BOOKED
    APPOINTMENT_CANCELLED
    APPOINTMENT_ATTENDED
  }

  enum ActivityOutcome <<enum>> {
    successful
    no_answer
    busy
    wrong_number
    not_interested
    interested
  }
}

' ─────────────────────────────────────────────────────────────
' Domain models — SQLAlchemy 2.0 ORM (12 entidades)
' ─────────────────────────────────────────────────────────────
package "app.modules.crm.models" <<Frame>> {

  class Person <<entity>> {
    +first_name: str
    +last_name: str
    +second_last_name: str?
    +document_type: str?
    +document_number: str?
    +birth_date: date?
    +gender: str?
    +address: str?
    +notes: str?
    --
    +identifiers: list<PersonContactIdentifier> <<lazy=raise>>
    ' lead_status/customer_status/assignment: NO son relationship() ORM
    ' — se resuelven por person_id + batch maps en el service (sin N+1).
  }

  class PersonContactIdentifier <<entity>> {
    +person_id: str <<FK>>
    +channel_type: str  ' ChannelType slug
    +identifier: str
    +is_primary: bool = false
    +verified: bool = false
    --
    ' UNIQUE (channel_type, identifier) WHERE deleted_at IS NULL
  }

  class LeadStatus <<entity, catalog>> {
    +code: str <<unique>>
    +name: str
    +description: str?
    +color: str?
    +is_initial: bool = false
    +is_final: bool = false
    +is_won: bool = false
    +display_order: int = 0
  }

  class CustomerStatus <<entity, catalog>> {
    +code: str <<unique>>
    +name: str
    +description: str?
    +color: str?
    +is_initial: bool = false
    +is_final: bool = false
    +display_order: int = 0
    --
    ' Idéntico a LeadStatus menos is_won
  }

  class LeadStatusTransition <<entity, matrix>> {
    +from_lead_status_id: str <<FK→lead_status>>
    +to_lead_status_id: str <<FK→lead_status>>
    --
    ' UNIQUE (from, to). PK·A·T — SIN SoftDeleteMixin (config, ADR-008)
  }

  class CustomerStatusTransition <<entity, matrix>> {
    +from_customer_status_id: str <<FK→customer_status>>
    +to_customer_status_id: str <<FK→customer_status>>
    --
    ' UNIQUE (from, to). PK·A·T — SIN SoftDeleteMixin (config, ADR-008)
  }

  class PersonLeadStatus <<entity>> {
    +person_id: str <<unique, FK>>
    +lead_status_id: str <<FK>>
    +source_campaign_id: str?  ' forward FK (ADR-009)
    +entered_status_at: datetime
    +last_activity_at: datetime?  ' denormalizado
    --
    ' SIN relationship a Person — se consulta por person_id + batch maps
    ' UNIQUE person_id WHERE deleted_at IS NULL (≤1 lead vivo)
  }

  class PersonCustomerStatus <<entity>> {
    +person_id: str <<unique, FK>>
    +customer_status_id: str <<FK>>
    +became_customer_at: datetime
    +entered_status_at: datetime
    --
    ' SIN relationship a Person — se consulta por person_id + batch maps
    ' UNIQUE person_id WHERE deleted_at IS NULL. Sin source_campaign_id
  }

  class LeadStatusHistory <<entity, immutable>> {
    +person_id: str <<FK>>
    +from_lead_status_id: str? <<FK>>
    +to_lead_status_id: str <<FK>>
    +source_campaign_id: str?  ' forward FK (ADR-009)
    +changed_at: datetime
    +changed_by: str?  ' FK lógica → user (NULL/SYSTEM si automático)
    +reason: str?
    --
    ' PK·A·T — SIN SoftDeleteMixin (audit trail honesto)
  }

  class CustomerStatusHistory <<entity, immutable>> {
    +person_id: str <<FK>>
    +from_customer_status_id: str? <<FK>>
    +to_customer_status_id: str <<FK>>
    +changed_at: datetime
    +changed_by: str?  ' FK lógica → user
    +reason: str?
    --
    ' PK·A·T — SIN SoftDeleteMixin. Sin source_campaign_id
  }

  class LeadAssignment <<entity>> {
    +person_id: str <<unique, FK>>
    +advisor_user_id: str <<FK→user>>
    +assigned_at: datetime
    +assigned_by: str?  ' FK lógica → user (NULL = round-robin auto)
    +reason: str?
    --
    ' SIN relationship a Person — se consulta por person_id + batch maps
    ' UNIQUE person_id WHERE deleted_at IS NULL (≤1 owner vivo)
  }

  class LeadActivity <<entity, polymorphic>> {
    +person_id: str <<FK>>
    +advisor_user_id: str? <<FK→user>>
    +activity_type: str  ' ActivityType slug
    +content: str?
    +scheduled_for: datetime?
    +completed_at: datetime?
    +outcome: str?  ' ActivityOutcome slug
    +payload: JSONB?
    +related_appointment_id: str?  ' forward FK (ADR-009)
    +related_conversation_id: str?  ' forward FK (ADR-009)
    --
    ' PK·A·T — SIN SoftDeleteMixin ("borrar" = active=false)
  }
}

' ─────────────────────────────────────────────────────────────
' Externos (informativo) — User existe; Campaign/Appointment/Conversation aún NO
' ─────────────────────────────────────────────────────────────
class "User" as User <<entity,external>> #lightgrey
class "Campaign" as Campaign <<entity,external,future>> #lightgrey
class "Appointment" as Appointment <<entity,external,future>> #lightgrey
class "Conversation" as Conversation <<entity,external,future>> #lightgrey

' ─────────────────────────────────────────────────────────────
' Repositories — un repo por entidad
' ─────────────────────────────────────────────────────────────
package "app.modules.crm.repositories" <<Frame>> {
  class PersonRepository {
    +ALLOWED_FIELDS: set  ' solo columnas reales de person
    --
    +get_by_identifier(db, channel_type, identifier): Person?
    +get_full(db, person_id): Person?  ' eager: solo identifiers (lead/customer/assignment via batch maps)
    +search(db, q?, channel_type?, identifier?, limit): list<Person>
    +list_active(db): list<Person>
  }
  class PersonContactIdentifierRepository {
    +list_for_person(db, person_id): list
    +get_by_identifier(db, channel_type, identifier): PersonContactIdentifier?
  }
  class LeadStatusRepository {
    +get_by_code(db, code): LeadStatus?
    +get_initial(db): LeadStatus?
    +count_initial(db, exclude_id?): int
  }
  class CustomerStatusRepository {
    +get_by_code(db, code): CustomerStatus?
    +get_initial(db): CustomerStatus?
    +count_initial(db, exclude_id?): int
  }
  class LeadStatusTransitionRepository {
    +is_allowed(db, from_id, to_id): bool
    +list_outgoing(db, from_id): list<str>
    +replace_outgoing(db, from_id, to_ids): None
  }
  class CustomerStatusTransitionRepository {
    +is_allowed(db, from_id, to_id): bool
    +list_outgoing(db, from_id): list<str>
    +replace_outgoing(db, from_id, to_ids): None
  }
  class PersonLeadStatusRepository {
    +get_active_for_person(db, person_id): PersonLeadStatus?
    +status_map(db, person_ids): dict  ' batch, sin N+1
    +last_activity_map(db, person_ids): dict
    +count_using_status(db, lead_status_id): int
  }
  class PersonCustomerStatusRepository {
    +get_active_for_person(db, person_id): PersonCustomerStatus?
    +status_map(db, person_ids): dict
    +count_using_status(db, customer_status_id): int
  }
  class LeadStatusHistoryRepository {
    +list_for_person(db, person_id, limit?): list
  }
  class CustomerStatusHistoryRepository {
    +list_for_person(db, person_id, limit?): list
  }
  class LeadAssignmentRepository {
    +get_active_for_person(db, person_id): LeadAssignment?
    +pick_round_robin_advisor(db): str?  ' SELECT … FOR UPDATE
    +list_advisors(db): list<User>  ' candidatos ASESOR (sin FOR UPDATE)
    +assignment_map(db, person_ids): dict  ' batch advisor user
  }
  class LeadActivityRepository {
    +list_for_person(db, person_id, types?, date_from?, date_to?): list
  }
}

' ─────────────────────────────────────────────────────────────
' Services — módulos funcionales (NO clases)
' ─────────────────────────────────────────────────────────────
package "app.modules.crm.services" <<Frame>> {
  class "person.py" as person_svc <<module>> {
    +get_by_id(db, person_id)
    +list_paginated(db, query, lead_status_id?, customer_status_id?, advisor_user_id?, has_active_lead?)  ' deep-link → EXISTS
    +list_active(db)
    +search(db, q?, channel_type?, identifier?)
    +create(db, payload, actor_id)  ' Person + identifiers nested, sin lead
    +update(db, person_id, payload, actor_id)
    +soft_delete(db, person_id, actor_id)
    +find_by_identifier_or_create(db, channel_type, identifier, profile, campaign_id?)  ' orquestación (bot), created_by=SYSTEM
  }
  class "contact_identifier.py" as ci_svc <<module>> {
    +list(db, person_id)
    +add(db, person_id, payload, actor_id)  ' dedup IDENTIFIER_TAKEN
    +update(db, person_id, ident_id, payload, actor_id)  ' is_primary único por canal
    +remove(db, person_id, ident_id, actor_id)
  }
  class "lead_status.py" as ls_svc <<module>> {
    +list_active(db) / list_paginated(db, query)
    +create/update/soft_delete(...)  ' 1 is_initial, is_won⟹is_final, guard *_IN_USE
    +get_transitions(db, status_id) / set_transitions(db, status_id, to_ids, actor_id)
  }
  class "customer_status.py" as cs_svc <<module>> {
    +(análogo a lead_status, sin is_won)
  }
  class "person_lead_status.py" as pls_svc <<module>> {
    +get(db, person_id)
    +create(db, person_id, payload, actor_id)  ' nace en is_initial
    +transition(db, person_id, to_id, actor_id, reason?)  ' matriz + cierre is_final
    +history(db, person_id)
  }
  class "person_customer_status.py" as pcs_svc <<module>> {
    +get(db, person_id)
    +transition(db, person_id, to_id, actor_id, reason?)
    +promote_from_lead(db, person_id, actor_id, reason?)  ' ALREADY_CUSTOMER
    +history(db, person_id)
  }
  class "lead_assignment.py" as la_svc <<module>> {
    +get(db, person_id)
    +reassign(db, person_id, new_advisor_id, actor_id, reason?)  ' ADVISOR_NOT_ASESOR
    +assign_round_robin(db, person_id, actor_id?)  ' concurrency-safe
    +list_advisors(db)  ' GET /advisors/active
    +my_leads(db, advisor_user_id, query)  ' /me/leads/list
  }
  class "lead_activity.py" as act_svc <<module>> {
    +list(db, person_id, types?, date_from?, date_to?)
    +create(db, person_id, payload, actor_id)  ' tipos de asesor
    +update(db, person_id, act_id, payload, actor_id)
    +delete(db, person_id, act_id, actor_id)  ' active=false
    +log(db, person_id, activity_type, advisor_user_id, actor_id, ...)  ' helper interno reusado
  }
}

' ─────────────────────────────────────────────────────────────
' Herencia de mixins (representativa — todas las entidades llevan PK·A·T)
' ─────────────────────────────────────────────────────────────
PrimaryKeyMixin <|-- Person
ActiveMixin     <|-- Person
SoftDeleteMixin <|-- Person
TimestampMixin  <|-- Person

PrimaryKeyMixin <|-- PersonContactIdentifier
PrimaryKeyMixin <|-- LeadStatus
PrimaryKeyMixin <|-- CustomerStatus
PrimaryKeyMixin <|-- LeadStatusTransition
PrimaryKeyMixin <|-- CustomerStatusTransition
PrimaryKeyMixin <|-- PersonLeadStatus
PrimaryKeyMixin <|-- PersonCustomerStatus
PrimaryKeyMixin <|-- LeadStatusHistory
PrimaryKeyMixin <|-- CustomerStatusHistory
PrimaryKeyMixin <|-- LeadAssignment
PrimaryKeyMixin <|-- LeadActivity

note bottom of TimestampMixin
  **Mixins por entidad (modelo final)**
  • Los 4 mixins (""PrimaryKeyMixin, ActiveMixin,""
    ""SoftDeleteMixin, TimestampMixin""):
    ""Person"", ""PersonContactIdentifier"",
    ""LeadStatus"", ""CustomerStatus"",
    ""PersonLeadStatus"", ""PersonCustomerStatus"",
    ""LeadAssignment"".
  • PK·A·T (SIN ""SoftDeleteMixin""):
    ""LeadStatusHistory"", ""CustomerStatusHistory"",
    ""LeadActivity"" (audit trail / timeline) y las
    transition tables ""LeadStatusTransition"" /
    ""CustomerStatusTransition"" (config: deshabilitar
    = ""active=false"" o DELETE real).
  (Sólo se dibujan las herencias de ""Person"".)
end note

' ─────────────────────────────────────────────────────────────
' Repos extienden el genérico BaseRepository<ModelT>
' ─────────────────────────────────────────────────────────────
BaseRepository <|-- PersonRepository                       : "<Person>"
BaseRepository <|-- PersonContactIdentifierRepository      : "<PersonContactIdentifier>"
BaseRepository <|-- LeadStatusRepository                   : "<LeadStatus>"
BaseRepository <|-- CustomerStatusRepository               : "<CustomerStatus>"
BaseRepository <|-- LeadStatusTransitionRepository         : "<LeadStatusTransition>"
BaseRepository <|-- CustomerStatusTransitionRepository     : "<CustomerStatusTransition>"
BaseRepository <|-- PersonLeadStatusRepository             : "<PersonLeadStatus>"
BaseRepository <|-- PersonCustomerStatusRepository         : "<PersonCustomerStatus>"
BaseRepository <|-- LeadStatusHistoryRepository            : "<LeadStatusHistory>"
BaseRepository <|-- CustomerStatusHistoryRepository        : "<CustomerStatusHistory>"
BaseRepository <|-- LeadAssignmentRepository               : "<LeadAssignment>"
BaseRepository <|-- LeadActivityRepository                 : "<LeadActivity>"

' ─────────────────────────────────────────────────────────────
' Relaciones de dominio (cardinalidades por FK; el único relationship()
' ORM real desde Person es "identifiers" — el resto se resuelve por
' person_id + batch maps en el service, sin N+1)
' ─────────────────────────────────────────────────────────────
"Person" "1" -- "0..*" PersonContactIdentifier   : "identifiers"
"Person" "1" -- "0..1" PersonLeadStatus          : "lead actual\n(UNIQUE)"
"Person" "1" -- "0..1" PersonCustomerStatus      : "cliente actual\n(UNIQUE)"
"Person" "1" -- "0..*" LeadStatusHistory         : "historial"
"Person" "1" -- "0..*" CustomerStatusHistory     : "historial"
"Person" "1" -- "0..1" LeadAssignment            : "owner\n(UNIQUE)"
"Person" "1" -- "0..*" LeadActivity              : "timeline"

LeadStatus     "1" -- "0..*" PersonLeadStatus
LeadStatus     "1" -- "0..*" LeadStatusHistory
CustomerStatus "1" -- "0..*" PersonCustomerStatus
CustomerStatus "1" -- "0..*" CustomerStatusHistory

' Matriz de transiciones (ADR-008): aristas from→to del grafo de estados
LeadStatus     "1" -- "0..*" LeadStatusTransition         : "from"
LeadStatus     "1" -- "0..*" LeadStatusTransition         : "to"
CustomerStatus "1" -- "0..*" CustomerStatusTransition     : "from"
CustomerStatus "1" -- "0..*" CustomerStatusTransition     : "to"

' FKs reales hacia user (admin.user ya existe)
LeadAssignment "*" -- "1" User                 : "advisor (FK)"
LeadActivity   "*" -- "0..1" User              : "actor (FK opcional)"

' Forward FKs (ADR-009): SOLO columna varchar(36)+index, SIN FK/relationship.
' El módulo dueño agrega la constraint luego → línea punteada (no association sólida).
PersonLeadStatus  ..> Campaign       : "source_campaign_id\n<<forward FK, ADR-009>>"
LeadStatusHistory ..> Campaign       : "source_campaign_id\n<<forward FK, ADR-009>>"
LeadActivity      ..> Appointment    : "related_appointment_id\n<<forward FK, ADR-009>>"
LeadActivity      ..> Conversation   : "related_conversation_id\n<<forward FK, ADR-009>>"

' ─────────────────────────────────────────────────────────────
' Repos manejan su modelo
' ─────────────────────────────────────────────────────────────
PersonRepository                       ..> Person
PersonContactIdentifierRepository      ..> PersonContactIdentifier
LeadStatusRepository                   ..> LeadStatus
CustomerStatusRepository               ..> CustomerStatus
LeadStatusTransitionRepository         ..> LeadStatusTransition
CustomerStatusTransitionRepository     ..> CustomerStatusTransition
PersonLeadStatusRepository             ..> PersonLeadStatus
PersonCustomerStatusRepository         ..> PersonCustomerStatus
LeadStatusHistoryRepository            ..> LeadStatusHistory
CustomerStatusHistoryRepository        ..> CustomerStatusHistory
LeadAssignmentRepository               ..> LeadAssignment
LeadActivityRepository                 ..> LeadActivity

' ─────────────────────────────────────────────────────────────
' Services usan repos (selectivo para legibilidad)
' ─────────────────────────────────────────────────────────────
person_svc ..> PersonRepository
person_svc ..> PersonContactIdentifierRepository
person_svc ..> LeadStatusRepository
person_svc ..> LeadAssignmentRepository
ci_svc     ..> PersonContactIdentifierRepository
ls_svc     ..> LeadStatusRepository
ls_svc     ..> LeadStatusTransitionRepository
cs_svc     ..> CustomerStatusRepository
cs_svc     ..> CustomerStatusTransitionRepository
pls_svc    ..> PersonLeadStatusRepository
pls_svc    ..> LeadStatusRepository
pls_svc    ..> LeadStatusTransitionRepository
pls_svc    ..> LeadStatusHistoryRepository
pls_svc    ..> act_svc
pcs_svc    ..> PersonCustomerStatusRepository
pcs_svc    ..> CustomerStatusTransitionRepository
pcs_svc    ..> CustomerStatusHistoryRepository
pcs_svc    ..> PersonLeadStatusRepository
la_svc     ..> LeadAssignmentRepository
la_svc     ..> act_svc
act_svc    ..> LeadActivityRepository
act_svc    ..> PersonLeadStatusRepository

' ─────────────────────────────────────────────────────────────
' Notas
' ─────────────────────────────────────────────────────────────
note right of Person
  **ADR-003**: estados ""lead"" y ""customer""
  coexisten en tablas hijas separadas
  (1:0..1 cada una, UNIQUE parcial por
  ""person_id WHERE deleted_at IS NULL"").
  Sin teléfono/email aquí (van en
  ""PersonContactIdentifier""). Sin datos
  médicos en MVP.
end note

note right of PersonContactIdentifier
  **Matching multicanal**
  ""conversations"" llama
  ""person.find_by_identifier_or_create(channel, id)""
  al recibir un mensaje entrante.
  Dedup: UNIQUE parcial (channel_type, identifier)
  → ""409 IDENTIFIER_TAKEN"".
end note

note bottom of LeadStatusTransition
  **Matriz configurable (ADR-008)**
  Aristas ""from→to"" del grafo de estados.
  ""person_lead_status.transition"" valida contra
  esta tabla (""is_allowed""). El seed instala una
  matriz base; admin la refina (LEAD_STATUSES_WRITE).
  ""PUT /lead-statuses/{id}/transitions"" reemplaza
  las salientes (DELETE + reinsert, sin SoftDelete).
end note

note bottom of LeadActivity
  **Timeline polimórfico**
  ""activity_type"" = enum ""ActivityType"" (completo
  desde el día 1). ""payload"" JSONB para datos del
  tipo. ""outcome"" = ""ActivityOutcome"" (califica
  ""CALL_ATTEMPT""). Los emiten crm hoy y
  conversations/scheduling más adelante.
end note

note bottom of la_svc
  **Round-robin sin tabla extra**
  ""pick_round_robin_advisor()"" elige el ASESOR
  con menos leads activos (empate → asignación
  más antigua) con ""SELECT … FOR UPDATE"".
  El UNIQUE parcial sobre ""lead_assignment.person_id""
  es el backstop. ""list_advisors"" reusa la query
  sin ""FOR UPDATE"" para ""GET /advisors/active"".
end note

note bottom of person_svc
  **User SYSTEM**
  ""00000000-0000-0000-0000-000000000002"".
  Operaciones automáticas (""find_by_identifier_or_create"",
  round-robin auto) escriben ""created_by = SYSTEM"";
  ""changed_by"" / ""assigned_by"" NULL o SYSTEM.
end note

note bottom of Campaign
  **Forward FKs (ADR-009)**
  ""source_campaign_id"" (PersonLeadStatus,
  LeadStatusHistory), ""related_appointment_id"" /
  ""related_conversation_id"" (LeadActivity) son
  ""str?"" (""varchar(36)"" + index) SIN ""ForeignKey""
  ni ""relationship"": las tablas ""campaign"" /
  ""appointment"" / ""conversation"" aún no existen.
  El módulo dueño (marketing/scheduling/conversations)
  agrega la constraint de forma aditiva luego.
end note

@enduml
