@startuml class-backend-scheduling
' Propósito: jerarquía OO del módulo scheduling (modelo FINAL, 5 entidades) — catálogo de estados + matriz de transiciones configurable (ADR-008),
'            Appointment (unidad persistida del calendario), dos audit-trails inmutables, repos + services (availability on-the-fly ADR-006/007 + lifecycle + bot facade).
' Última actualización: 2026-06-06 — modelo final (5 entidades + matriz; disponibilidad on-the-fly ADR-006/007)
' Código de referencia: backend/app/modules/scheduling/ y backend/app/shared/

!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 50
skinparam ranksep 65
skinparam defaultFontSize 13
hide empty members

title Class — Backend · Scheduling module

' ─────────────────────────────────────────────────────────────
' Shared layer — mixins y base genérica
' ─────────────────────────────────────────────────────────────
package "app.shared" <<Frame>> {
  together {
    class PrimaryKeyMixin <<mixin>> {
      +id: str <<UUID>>
    }
    class ActiveMixin <<mixin>> {
      +active: bool
    }
    class SoftDeleteMixin <<mixin>> {
      +deleted_at: datetime?
    }
    class TimestampMixin <<mixin>> {
      +created_on: datetime
      +created_by: str
      +updated_on: datetime
      +updated_by: str
    }
  }

  abstract class "BaseRepository<ModelT>" as BaseRepository {
    +ALLOWED_FIELDS: set<str>
    +model: type<ModelT>
    --
    +get_by_id(db, id, ...): ModelT?
    +get_paginated(db, query_request, load): tuple<list, int>
    +create(db, obj): ModelT
    +update(db, obj, changes): ModelT
    +soft_delete(db, obj): None
  }
}

' ─────────────────────────────────────────────────────────────
' Enums (en código, NO en BD — varchar plano en la columna)
' ─────────────────────────────────────────────────────────────
package "app.modules.scheduling.enums" <<Frame>> {
  enum AppointmentSource <<enum>> {
    bot
    advisor
    admin
    import_   ' value = "import" (palabra reservada en Python)
    api
  }
}

' ─────────────────────────────────────────────────────────────
' Domain models — SQLAlchemy 2.0 ORM (5 entidades)
' ─────────────────────────────────────────────────────────────
package "app.modules.scheduling.models" <<Frame>> {

  class AppointmentStatus <<entity, catalog>> {
    +code: str <<unique>>   ' MAYÚSCULAS, sin pattern slug
    +name: str
    +description: str?
    +color: str?
    +is_initial: bool = false   ' exactamente uno
    +is_final: bool = false
    +is_active_attention: bool = false
    +display_order: int = 0
  }

  class AppointmentStatusTransition <<entity, matrix>> {
    +from_status_id: str <<FK→appointment_status>>
    +to_status_id: str <<FK→appointment_status>>
    --
    ' UNIQUE (from, to). PK·A·T — SIN SoftDeleteMixin (config, ADR-008)
  }

  class Appointment <<entity>> {
    +person_id: str <<FK→person>>
    +doctor_id: str <<FK→doctor>>
    +office_id: str <<FK→office>>
    +branch_id: str <<FK→branch>>   ' denorm de office.branch_id
    +product_id: str <<FK→product>>
    +scheduled_for: datetime        ' UTC
    +duration_min: int              ' copiado de product.duration_min
    +status_id: str <<FK→appointment_status>>
    +source: str                    ' AppointmentSource slug
    +previous_appointment_id: str? <<FK self>>
    +notes: str?
    +cancellation_reason: str?
    +cancelled_at: datetime?
    +cancelled_by: str? <<FK→user>>
    +confirmed_at: datetime?
    +attended_at: datetime?
    --
    ' Sin relationship ORM cross-módulo ni a la self-FK
    ' (todo por id + batch maps). NO se soft-deletea al cerrar.
  }

  class AppointmentStatusHistory <<entity, immutable>> {
    +appointment_id: str <<FK→appointment>>
    +from_status_id: str? <<FK→appointment_status>>   ' NULL en la creación
    +to_status_id: str <<FK→appointment_status>>
    +changed_at: datetime
    +changed_by: str? <<FK→user>>   ' NULL = bot/sistema
    +reason: str?
    --
    ' PK·A·T — SIN SoftDeleteMixin (audit trail honesto)
  }

  class AppointmentChangeLog <<entity, immutable>> {
    +appointment_id: str <<FK→appointment>>
    +field_name: str   ' doctor_id / office_id / product_id / notes / ...
    +previous_value: str?
    +new_value: str?
    +changed_at: datetime
    +changed_by: str? <<FK→user>>
    +reason: str?
    --
    ' PK·A·T — SIN SoftDeleteMixin. status_id NO va acá (→ History)
  }
}

' ─────────────────────────────────────────────────────────────
' Externos (informativo) — TODOS YA existen en prod (FK real, sin relationship)
' ─────────────────────────────────────────────────────────────
class "Person" as Person <<entity,external>> #lightgrey
class "Doctor" as Doctor <<entity,external>> #lightgrey
class "Office" as Office <<entity,external>> #lightgrey
class "Branch" as Branch <<entity,external>> #lightgrey
class "Product" as Product <<entity,external>> #lightgrey
class "User" as User <<entity,external>> #lightgrey

' ─────────────────────────────────────────────────────────────
' Repositories — un repo por entidad
' ─────────────────────────────────────────────────────────────
package "app.modules.scheduling.repositories" <<Frame>> {
  class AppointmentStatusRepository {
    +ALLOWED_FIELDS: set  ' code/name/flags/display_order/active/timestamps
    --
    +get_by_code(db, code): AppointmentStatus?
    +get_initial(db): AppointmentStatus?
    +count_initial(db, exclude_id?): int
    +count_using_status(db, status_id): int  ' guard DELETE → IN_USE
    +get_by_ids(db, ids): list  ' batch badge
  }
  class AppointmentStatusTransitionRepository {
    +is_allowed(db, from_id, to_id): bool
    +list_outgoing(db, from_id): list<str>
    +replace_outgoing(db, from_id, to_ids): None
  }
  class AppointmentRepository {
    +ALLOWED_FIELDS: set  ' SOLO columnas reales (lección cd10c78)
    --
    +list_overlapping_for_doctor(db, doctor_id, start, end, blocking_ids, exclude_id?, for_update?): list
    +list_overlapping_for_office(db, office_id, start, end, blocking_ids, exclude_id?, for_update?): list
    +list_in_range(db, doctor_id?, office_id?, branch_id?, start, end, status_ids?): list
    +list_for_doctor_paginated(db, query_request, doctor_id): tuple<list, int>  ' /me, anti-IDOR
    --
    ' Batch maps (sin N+1):
    +person_name_map(db, ids) / doctor_name_map(db, ids)
    +office_map(db, ids) / branch_name_map(db, ids) / product_name_map(db, ids)
  }
  class AppointmentStatusHistoryRepository {
    +ALLOWED_FIELDS = set()  ' sin /list
    +list_for_appointment(db, appointment_id): list  ' changed_at asc
  }
  class AppointmentChangeLogRepository {
    +ALLOWED_FIELDS = set()
    +list_for_appointment(db, appointment_id): list  ' changed_at asc
  }
}

' ─────────────────────────────────────────────────────────────
' Services — módulos funcionales (NO clases)
' ─────────────────────────────────────────────────────────────
package "app.modules.scheduling.services" <<Frame>> {
  class "appointment_status.py" as as_svc <<module>> {
    +list_options(db) / list_paginated(db, query)
    +get_by_id(db, status_id)
    +create/update/soft_delete(...)  ' 1 is_initial (MULTIPLE_INITIAL_STATUS), guard *_IN_USE
    +get_transitions(db, status_id) / set_transitions(db, status_id, to_ids, actor_id)
  }
  class "appointment_status_transition.py" as ast_svc <<module>> {
    +is_allowed(db, from_id, to_id): bool
    +list_outgoing(db, from_id) / replace_outgoing(db, from_id, to_ids, actor_id)
    --
    ' Matriz ADR-008 — ausencia de arista ⟹ APPOINTMENT_TRANSITION_NOT_ALLOWED (en transition.py)
  }
  class "availability.py" as av_svc <<module>> {
    +compute_available_slots(db, doctor_id, product_id, branch_id?, office_id?, from_date, to_date): AvailabilityResponse
    +check_slot(db, doctor_id, office_id, product_id, scheduled_for): CheckSlotResponse
    --
    ' ADR-006/007 — NO persiste. Lee DoctorAvailability (bloques concretos),
    ' OfficeOperatingHours/Closure, office_vertical, slot_duration_min,
    ' Product.duration_min y appointment activas. TZ = branch.timezone.
  }
  class "appointment.py" as appt_svc <<module>> {
    +get_by_id(db, appointment_id) / list_paginated(db, query)
    +list_for_doctor_me(db, current, query)  ' anti-IDOR scoped
    +calendar(db, doctor_id?, office_id?, branch_id?, from, to)  ' citas + free_slots
    +create(db, payload, actor_id)  ' 9 invariantes + FOR UPDATE → SLOT_TAKEN
    +update(db, appointment_id, payload, actor_id)  ' no-estado → ChangeLog
    +soft_delete(db, appointment_id, actor_id)  ' "error de captura"
    +reschedule(db, appointment_id, payload, actor_id)  ' marca vieja RESCHEDULED + nueva tx
    --
    ' _validate_booking_invariants (1..8) + _has_overlap (FOR UPDATE)
  }
  class "transition.py" as tr_svc <<module>> {
    +transition(db, appointment_id, to_status_id, actor_id, reason?)  ' valida matriz
    +confirm / check_in / start / attend / no_show (shortcuts por code)
    +cancel(db, appointment_id, payload, actor)  ' inv #9 CANCEL_TOO_LATE (+ override)
    --
    ' attend → crm.promote_to_customer (atómico) + LeadActivity(APPOINTMENT_ATTENDED)
    ' Side-effects por code del destino (confirmed_at/cancelled_at/attended_at)
  }
  class "bot_facade.py" as bot_svc <<module>> {
    +book_from_bot(db, ctx, doctor_id, office_id, product_id, ...): Appointment
    +cancel_from_bot(db, ctx, appointment_id): Appointment
    --
    ' SYSTEM, source='bot', respeta TODOS los invariantes (sin override).
    ' bots/services/engine/tools/scheduling.py invoca vía TOOL_REGISTRY:
    ' check_availability / book_appointment / cancel_appointment
  }
}

