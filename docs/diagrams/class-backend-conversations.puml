@startuml class-backend-conversations
' Propósito: jerarquía OO del módulo conversations (modelo FINAL, 5 entidades) — pipe de mensajería
'            multicanal: ChannelAccount + Conversation + Message/MessageAttachment + ConversationAssignmentLog,
'            secret_resolver en app.core, webhook processors por canal y enganche aditivo con crm.
' Última actualización: 2026-06-02
' Código de referencia: backend/app/modules/conversations/, backend/app/core/secrets.py, app/routers/webhooks.py

!theme plain
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 50
skinparam ranksep 65
skinparam defaultFontSize 13
hide empty members

title Class — Backend · Conversations module

' ─────────────────────────────────────────────────────────────
' Shared layer — mixins y base genérica
' ─────────────────────────────────────────────────────────────
package "app.shared" <<Frame>> {
  together {
    class PrimaryKeyMixin <<mixin>> {
      +id: str <<UUID>>
    }
    class ActiveMixin <<mixin>> {
      +active: bool
    }
    class SoftDeleteMixin <<mixin>> {
      +deleted_at: datetime?
    }
    class TimestampMixin <<mixin>> {
      +created_on: datetime
      +created_by: str
      +updated_on: datetime
      +updated_by: str
    }
  }

  abstract class "BaseRepository<ModelT>" as BaseRepository {
    +ALLOWED_FIELDS: set<str>
    +model: type<ModelT>
    --
    +get_by_id(db, id, ...): ModelT?
    +get_paginated(db, query_request, load): tuple<list, int>
    +create(db, obj): ModelT
    +update(db, obj, changes): ModelT
    +soft_delete(db, obj): None
  }
}

' ─────────────────────────────────────────────────────────────
' Enums conversations-owned (en código, NO en BD — varchar plano)
' ChannelType NO vive aquí: se REUSA de crm.enums (single source of truth).
' ─────────────────────────────────────────────────────────────
package "app.modules.conversations.enums" <<Frame>> {
  enum ConversationStatus <<enum>> {
    open
    closed
  }
  enum AssigneeType <<enum>> {
    bot
    advisor
    unassigned
  }
  enum MessageDirection <<enum>> {
    inbound
    outbound
  }
  enum SenderType <<enum>> {
    contact
    bot
    advisor
    system
  }
  enum ContentType <<enum>> {
    text
    image
    audio
    video
    document
    location
    sticker
    contact_card
    system_notification
  }
  enum AttachmentType <<enum>> {
    image
    audio
    video
    document
    location
    sticker
    contact_card
  }
  enum MessageExternalStatus <<enum>> {
    sent
    delivered
    read
    failed
  }
}

' ─────────────────────────────────────────────────────────────
' Domain models — SQLAlchemy 2.0 ORM (5 entidades)
' ─────────────────────────────────────────────────────────────
package "app.modules.conversations.models" <<Frame>> {
  class ChannelAccount <<entity>> {
    +channel_type: str  ' crm.ChannelType slug (reuse)
    +name: str
    +external_identifier: str
    +secret_name: str?  ' ref al secreto en GCP Secret Manager
    +webhook_verify_token: str?
    +phone_number_id: str?  ' WA Cloud API → /{phone_number_id}/messages
    +bot_configuration_id: str? <<FK>>
    +default_campaign_id: str? <<FK>>
    --
    ' UNIQUE PARTIAL (channel_type, external_identifier)
    '   WHERE deleted_at IS NULL → 409 CHANNEL_ACCOUNT_EXTERNAL_TAKEN
  }

  class Conversation <<entity>> {
    +channel_account_id: str <<FK>>
    +person_id: str? <<FK>>
    +status: str  ' ConversationStatus: open / closed
    +assignee_type: str  ' AssigneeType: bot / advisor / unassigned
    +assignee_user_id: str? <<FK>>
    +bot_configuration_id: str? <<FK>>
    +opened_at: datetime
    +closed_at: datetime?
    +last_message_at: datetime?  ' denormalizado (sort/inbox)
    +last_message_preview: str?
    +unread_count: int = 0
    --
    ' UNIQUE PARTIAL (person_id, channel_account_id)
    '   WHERE status='open' AND deleted_at IS NULL
    ' Invariantes (service): advisor⟺assignee_user_id set,
    '   cerrar/reasignar cierra+abre ConversationAssignmentLog.
  }

  class Message <<entity, immutable>> {
    +conversation_id: str <<FK>>
    +direction: str  ' MessageDirection
    +sender_type: str  ' SenderType
    +sender_user_id: str? <<FK>>
    +bot_configuration_id: str? <<FK>>
    +content_type: str  ' ContentType
    +content: str?
    +external_id: str?  ' WA wamid / Telegram message_id
    +external_status: str?  ' MessageExternalStatus (varchar libre)
    +sent_at: datetime
    +delivered_at: datetime?
    +read_at: datetime?
    +failed_at: datetime?
    +failure_reason: str?
    +provider_payload: JSONB?
    --
    ' UNIQUE PARTIAL (conversation_id, external_id)
    '   WHERE external_id IS NOT NULL → idempotencia reenvío Meta
    ' PK·A·T — SIN SoftDeleteMixin (audit inmutable)
  }

  class MessageAttachment <<entity, immutable>> {
    +message_id: str <<FK>>
    +attachment_type: str  ' AttachmentType
    +url: str?  ' storage en F4 (lazy proxy vs GCS por confirmar)
    +mime_type: str?
    +size_bytes: int?
    +duration_sec: int?
    +latitude: Decimal?
    +longitude: Decimal?
    +address_label: str?
    +original_filename: str?
    +external_media_id: str?
    +metadata: JSONB?
    --
    ' PK·A·T — SIN SoftDeleteMixin
    ' Modelado en F2; processing diferido a F4 (texto-primero).
  }

  class ConversationAssignmentLog <<entity, immutable>> {
    +conversation_id: str <<FK>>
    +from_assignee_type: str?
    +from_assignee_user_id: str? <<FK>>
    +to_assignee_type: str
    +to_assignee_user_id: str? <<FK>>
    +started_at: datetime
    +ended_at: datetime?  ' NULL = vigente
    +by_actor_user_id: str? <<FK>>  ' NULL = automático (auto-asignación)
    +reason: str?
    --
    ' PK·A·T — SIN SoftDeleteMixin (audit handoff inmutable)
  }
}

' ─────────────────────────────────────────────────────────────
' Repositories — un repo por entidad
' ─────────────────────────────────────────────────────────────
package "app.modules.conversations.repositories" <<Frame>> {
  class ChannelAccountRepository {
    +ALLOWED_FIELDS: set  ' solo columnas reales de channel_account
    --
    +get_by_external(db, channel_type, external_identifier): ChannelAccount?
    +list_active(db): list<ChannelAccount>
  }
  class ConversationRepository {
    +ALLOWED_FIELDS: set  ' status, assignee_type, assignee_user_id,
    '   channel_account_id, last_message_at, created_on, unread_count
    --
    +get_open(db, person_id, channel_account_id): Conversation?
    +get_full(db, conversation_id): Conversation?
    +list_inbox(db, query, assignee_user_id?, unassigned?): tuple<list, int>
  }
  class MessageRepository {
    +ALLOWED_FIELDS: set  ' sent_at, direction, content_type,
    '   sender_type, external_status
    --
    +list_for_conversation(db, conversation_id, query): tuple<list, int>
    +get_by_external_id(db, conversation_id, external_id): Message?
    +append(db, message, attachments?): Message
  }
  class MessageAttachmentRepository {
    +list_for_message(db, message_id): list
    +attachments_map(db, message_ids): dict  ' batch inline en MessageItem
  }
  class ConversationAssignmentLogRepository {
    +list_for_conversation(db, conversation_id): list
    +get_current(db, conversation_id): ConversationAssignmentLog?
    +close_current(db, conversation_id, ended_at): None
    +open_new(db, payload): ConversationAssignmentLog
  }
}

' ─────────────────────────────────────────────────────────────
' Secret resolver — cross-cutting, en app.core (ADR-010), reusable
' ─────────────────────────────────────────────────────────────
package "app.core" <<Frame>> #lightyellow {
  class "secrets.py" as secrets_mod <<module>> {
    -_client: SecretManagerClient?  ' lazy (no al import)
    -_cache: dict<str, (dict, float)>  ' TTL ≈10 min (monotonic)
    --
    +resolve(secret_name): dict  ' {access_token, app_secret, phone_number_id?}
    -_get_client(): SecretManagerClient  ' init lazy del SDK
    --
    ' google-cloud-secret-manager (async si la versión lo expone,
    ' sino sync en threadpool). Cache TTL para no golpear SM por webhook.
  }
}

' ─────────────────────────────────────────────────────────────
' Services — módulos funcionales (NO clases)
' ─────────────────────────────────────────────────────────────
package "app.modules.conversations.services" <<Frame>> {
  class "channel_account.py" as ca_svc <<module>> {
    +get_by_id / list_paginated / list_active
    +create / update / soft_delete(...)  ' dedup CHANNEL_ACCOUNT_EXTERNAL_TAKEN
    +get_credentials(channel_account): dict  ' secret_name → core.secrets.resolve
    '   o fallback env (Settings); vacío → CHANNEL_CREDENTIALS_MISSING (500)
  }
  class "conversation.py" as conv_svc <<module>> {
    +find_or_create_open(db, person_id, channel_account)  ' AUTO-ASIGNA
    '   al dueño del lead (crm.advisor_map) / fallback unassigned + log
    +get_by_id / list_inbox / get_my_inbox
    +take(db, conversation_id, actor_id, reason?)  ' reset unread + log
    '   + emite CONVERSATION_TAKEN a crm.lead_activity.log
    +release(db, conversation_id, to_type, actor_id, reason?)  ' MVP: unassigned
    '   + emite CONVERSATION_RELEASED a crm.lead_activity.log
    +close(db, conversation_id, actor_id)  ' status=closed, cierra log vigente
    +reopen(db, conversation_id, actor_id)  ' guard CONVERSATION_ALREADY_OPEN
    +mark_read(db, conversation_id, actor_id)  ' unread_count=0
  }
  class "message.py" as msg_svc <<module>> {
    +list(db, conversation_id, query)
    +persist_inbound(db, conversation, payload)  ' dedup external_id,
    '   unread++, last_message_at/preview (texto-primero, sin attachments)
    +send_outbound(db, conversation_id, content, actor_id)  ' real Meta Graph API:
    '   persiste Message → core.secrets vía ca.get_credentials → POST /messages;
    '   falla → failed_at/failure_reason, devuelve 200 (NO 502). NO emite MESSAGE_SENT.
    +apply_status(db, external_id, status)  ' delivered_at/read_at/failed_at
  }
}

' ─────────────────────────────────────────────────────────────
' Webhook processors (sub-paquete de services, cohesión por canal)
' ─────────────────────────────────────────────────────────────
package "app.modules.conversations.services.webhook_processor" <<Frame>> {
  class "whatsapp.py" as wpw <<module>> {
    +verify_signature(headers, raw_body, app_secret): bool  ' HMAC SHA256
    +process_inbound(payload, channel_account, db): list<Message>  ' síncrono
    +process_status(payload, channel_account, db): None
  }
  class "telegram.py" as wpt <<module, future>> {
    ' DIFERIDO — modelo/enum ya lo soportan, falta el processor
    +verify_secret_token(headers, expected_token): bool
    +process_inbound(payload, channel_account, db): list<Message>
  }
}

' ─────────────────────────────────────────────────────────────
' Top-level webhook router (FUERA de modules/, sin JWT)
' ─────────────────────────────────────────────────────────────
package "app.routers" <<Frame, External>> #lightyellow {
  class "webhooks.py" as wh_router <<module>> {
    +GET  /api/v1/webhooks/whatsapp/{channel_account_id}  ' verify challenge
    +POST /api/v1/webhooks/whatsapp/{channel_account_id}  ' inbound + status
    +POST /api/v1/webhooks/telegram/{channel_account_id}  ' DIFERIDO
    --
    ' Sin JWT. Carga ChannelAccount → get_credentials → valida firma
    ' (mismatch → 403 WEBHOOK_SIGNATURE_INVALID) → delega al processor.
  }
}

