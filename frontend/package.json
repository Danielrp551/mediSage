    "clsx": "^2.1.1",
    "firebase": "^11.1.0",
    "jose": "^5.10.0",
    "next": "16.1.6",
    "nuqs": "^2.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.72.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
