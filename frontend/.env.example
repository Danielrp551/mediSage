# ─── Backend URL (server-only — never exposed to the browser) ───
# Used by Server Components / Route Handlers / Server Actions to call FastAPI.
BACKEND_URL=http://localhost:8080

# ─── App URL (for absolute URLs in redirects, metadata, emails) ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth cookie domain (leave empty in dev, set in prod) ───
AUTH_COOKIE_DOMAIN=

# ─── Cookie security ───
# Default: on in production builds (Vercel / `next start`), off in `next dev`.
# Set explicitly to override — most apps should leave this commented out.
# AUTH_COOKIE_SECURE=true
